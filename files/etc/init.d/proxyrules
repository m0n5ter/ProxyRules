#!/bin/sh /etc/rc.common
# proxyrules: sing-box driven by the rules in /etc/proxyrules.conf

START=99
STOP=10
USE_PROCD=1

CONF=/etc/proxyrules.conf
LIB=/usr/share/proxyrules
RUN=/var/run/proxyrules
DNS_BACKUP=/etc/proxyrules/dnsmasq.orig

log() {
	logger -t proxyrules "$*"
	echo "$*" >&2
}

load_env() {
	[ -f "$RUN/env.sh" ] && . "$RUN/env.sh"
}

net_up() {
	nft -f "$RUN/nft.conf" || return 1
	ip route replace local 0.0.0.0/0 dev lo table "$ROUTE_TABLE"
	ip rule del fwmark "$MARK/$MARK" table "$ROUTE_TABLE" 2>/dev/null
	ip rule add fwmark "$MARK/$MARK" table "$ROUTE_TABLE" priority "$ROUTE_TABLE"
}

net_down() {
	load_env
	[ -n "$NFT_TABLE" ] && nft delete table inet "$NFT_TABLE" 2>/dev/null
	if [ -n "$MARK" ]; then
		while ip rule del fwmark "$MARK/$MARK" table "$ROUTE_TABLE" 2>/dev/null; do :; done
		ip route flush table "$ROUTE_TABLE" 2>/dev/null
	fi
}

# dnsmasq forwards all queries to sing-box (fake-ip for the domains in the rules).
# The original settings are saved once and restored on stop.
dns_on() {
	if [ ! -f "$DNS_BACKUP" ]; then
		{
			echo "server='$(uci -q get dhcp.@dnsmasq[0].server)'"
			echo "noresolv='$(uci -q get dhcp.@dnsmasq[0].noresolv)'"
			echo "cachesize='$(uci -q get dhcp.@dnsmasq[0].cachesize)'"
		} > "$DNS_BACKUP"
	fi
	uci -q delete dhcp.@dnsmasq[0].server
	uci add_list dhcp.@dnsmasq[0].server="$DNS_ADDR"
	uci set dhcp.@dnsmasq[0].noresolv=1
	uci set dhcp.@dnsmasq[0].cachesize=0
	uci commit dhcp
	/etc/init.d/dnsmasq restart
}

dns_off() {
	[ -f "$DNS_BACKUP" ] || return 0
	local server noresolv cachesize s
	. "$DNS_BACKUP"
	uci -q delete dhcp.@dnsmasq[0].server
	for s in $server; do
		uci add_list dhcp.@dnsmasq[0].server="$s"
	done
	if [ -n "$noresolv" ]; then uci set dhcp.@dnsmasq[0].noresolv="$noresolv"; else uci -q delete dhcp.@dnsmasq[0].noresolv; fi
	if [ -n "$cachesize" ]; then uci set dhcp.@dnsmasq[0].cachesize="$cachesize"; else uci -q delete dhcp.@dnsmasq[0].cachesize; fi
	uci commit dhcp
	rm -f "$DNS_BACKUP"
	/etc/init.d/dnsmasq restart
}

start_service() {
	if [ ! -f "$CONF" ]; then
		log "$CONF not found"
		return 1
	fi

	mkdir -p "$RUN" /etc/proxyrules
	chmod 700 "$RUN" /etc/proxyrules

	if ! ucode "$LIB/gen.uc" "$CONF" "$RUN" >/dev/null 2>"$RUN/error"; then
		log "error in $CONF: $(cat "$RUN/error")"
		return 1
	fi
	if ! sing-box check -c "$RUN/config.json" 2>"$RUN/error"; then
		log "sing-box rejected the config: $(cat "$RUN/error")"
		return 1
	fi
	rm -f "$RUN/error"

	load_env
	if ! net_up; then
		log "failed to set up nftables/routing"
		net_down
		return 1
	fi

	procd_open_instance sing-box
	procd_set_param command /usr/bin/sing-box run -c "$RUN/config.json" -D "$RUN"
	procd_set_param limits nofile="65535 65535"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance watchdog
	procd_set_param command /usr/bin/ucode "$LIB/watchdog.uc" "$RUN"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	dns_on
}

stop_service() {
	dns_off
	net_down
}

reload_service() {
	stop
	start
}
