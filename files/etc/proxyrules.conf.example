# ═══════════════════════════════════════════════════════════════════════════
#  proxyrules — which traffic goes through which connection
#
#  CONNECTIONS          NAME = vless://…           (the whole link, as the server gave it)
#                       NAME = iface:awg0          (OpenWrt interface: AmneziaWG, WireGuard…)
#
#  CHAINS               NAME = DE,NL               first live connection in order;
#                                                  when a higher-priority one comes back —
#                                                  switch back to it
#                       NAME = NL,direct           if NL is down — go direct
#                       a chain holds only connections and direct (chains don't nest)
#
#                       names: Latin letters, digits, "-"; direct and block are reserved
#
#  RULES                condition [& condition…] -> TARGET
#                       checked TOP TO BOTTOM, the first match wins
#
#  CONDITIONS           type:value[, value…]           (comma means "or")
#
#    domain:example.com        the domain and all its subdomains
#    list:discord              itdoginfo/allow-domains list (domains + subnets)
#                              available: anime block cloudflare cloudfront digitalocean discord
#                              geoblock google_ai google_meet google_play hdrezka hetzner
#                              hodca meta news ovh porn roblox russia_inside russia_outside
#                              telegram tiktok twitter ukraine_inside youtube
#                              (current set — the *.srs files in the latest release:
#                              github.com/itdoginfo/allow-domains/releases/latest)
#    ip:203.0.113.0/24         destination address or subnet
#    src:192.168.1.15          LAN device (or subnet) — all of its traffic
#    port:443, 50000-65535     destination port (TCP and UDP)
#    protocol:bittorrent       recognised by the first packets: bittorrent tls http quic
#                              stun dtls ssh rdp ntp. Seen only in traffic that already
#                              goes through a proxy, so on its own — only -> direct
#                              (put it above the rules it should override); with other
#                              targets add another condition: src:… & protocol:quic -> block
#
#    &   — "and": src:192.168.1.15 & domain:aaa.com -> DE       only aaa.com from this device
#    !   — "not": !src:192.168.1.15 & domain:bbb.com -> block   everyone except this device
#    at least one condition must be without "!" (except rules with target direct)
#
#  TARGETS              AUTO                a chain
#                       NL                  a single connection, no fallback
#                       direct              direct, no proxy
#                       block               block
#                       (also inline in a rule: -> NL,DE — an unnamed chain)
#
#  Anything not matched by any rule goes direct.
#  Comment — "#" at the start of a line or after a space.
# ═══════════════════════════════════════════════════════════════════════════

# ── Settings (fine to leave as is) ──────────────────────────────────────────
@interfaces     = br-lan            # where to intercept traffic from
@dns            = 8.8.8.8           # DoH server
@bootstrap      = 77.88.8.8
@check_url      = https://www.gstatic.com/generate_204
@check_interval = 10                # seconds between connection checks
@lists_via      = AUTO              # what to download list: lists through
@log            = warn

# ── Connections ─────────────────────────────────────────────────────────────
# Replace with your own links (the whole vless://… as the server gave it).
DE  = vless://UUID@203.0.113.10:443?type=tcp&security=reality&pbk=KEY&sid=SID&sni=www.microsoft.com&fp=chrome&flow=xtls-rprx-vision#DE
NL  = vless://UUID@203.0.113.20:443?type=tcp&security=reality&pbk=KEY&sid=SID&sni=www.microsoft.com&fp=chrome&flow=xtls-rprx-vision#NL
# AWG = iface:awg0

# ── Chains ──────────────────────────────────────────────────────────────────
AUTO     = DE,NL
NL-FIRST = NL,DE
NL-ONLY  = NL

# ── Rules ───────────────────────────────────────────────────────────────────

# Torrents — never through the proxy, from any device (even those sent via src: below)
protocol:bittorrent                                                 -> direct

# Your own servers — always direct, from any device.
# Comes first so that src: and list:hetzner/ovh/… below don't catch it.
ip:203.0.113.10, 203.0.113.20                                       -> direct

# A site that must always open from one country, from any device.
# It is above src:, so the devices below get NL only for it too.
domain:example.com                                                  -> NL-ONLY

# Whole devices
src:192.168.1.50                                                    -> AUTO       # laptop
src:192.168.1.60                                                    -> NL-FIRST   # game console

# Only this device goes through the proxy for the site; everyone else direct
src:192.168.1.50 & domain:example.org                               -> DE

# Foreign and blocked services
domain:anthropic.com, claude.ai, claude.com, claudeusercontent.com  -> AUTO
domain:openai.com, chatgpt.com, oaiusercontent.com                  -> AUTO
domain:ai.google, aistudio.google.com, gemini.google.com            -> AUTO
domain:github.com, githubusercontent.com, githubcopilot.com         -> AUTO
domain:linkedin.com, licdn.com, medium.com, spotify.com             -> AUTO

list:youtube, discord, meta, twitter, telegram, tiktok, news        -> AUTO
list:google_ai, cloudflare, cloudfront, hetzner, ovh, digitalocean  -> AUTO

# Ads and trackers — blocked
domain:doubleclick.net                                              -> block
